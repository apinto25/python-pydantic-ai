# Copia este archivo a .env y completa los valores: cp .env.example .env

# Clave de API de Google Gemini (obligatoria). Consíguela en https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Token de escritura de Logfire (opcional). Si no lo defines, ejecuta `uv run logfire auth`
# para autenticarte y `uv run logfire projects use <proyecto>` para elegir el proyecto.
# LOGFIRE_TOKEN=
